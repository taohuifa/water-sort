{
  // ═══════════════════════════════════════════════════════════
  // 缤纷果汁铺 · 关卡配置 v3（逐关显式，JSONC）
  //
  // 结构：defaults（默认关卡模板）+ levels（每关一条记录，聚合在一起）。
  // 取值优先级：levels[n].<字段>  >  defaults.<字段>  >  内置兜底。
  //
  // 生成管线（v3 分级，可解性保证）：
  //   ① 瓶结构（大小/数量 + 空瓶）→ ② 机制位置（隐藏槽位/锁瓶/钥匙深度）
  //   → ③ 液体打散洗混 → ④ DFS 求解器验证（不用道具必有解），不合格换 attempt 重洗
  //
  // 逐关随机种子 seed：缺省 = seedBase + 关卡号。对某关生成局面满意后，
  // 把该 seed 写进该关记录（"seed": N）即可固化局面——同 seed 永远复现同一副牌；
  // 不满意时改一个新 seed 即可换一副牌，不影响其他关。
  //
  // 说明：本文件内容为 JSONC（JSON + 注释）。微信小游戏仅允许读取 .json 等
  // 白名单扩展名的代码包文件，故用 .json 扩展名存放，加载时由 js/core/levels.js
  // 的 parseJsonc 剥离注释后解析。
  // ═══════════════════════════════════════════════════════════
  "levelCount": 30,
  "seedBase": 101,

  // —— 默认关卡模板（每条关卡记录缺失的字段回退到这里）——
  "defaults": {
    "colors": 4,           // 颜色数
    "empties": 2,          // 空瓶数（中转位）
    "capacity": 4,         // 每瓶层数（均一容量关）
    "hiddenCount": 0,      // 「?」隐藏层数
    "condLockCount": 0,    // 条件锁数
    "condLockNeed": 2,     // 条件锁需完成成品数
    "keyLockCount": 0,     // 钥匙锁数
    "noEmptyStart": false, // 无空瓶开局
    "mix": false,          // 混合容量关（瓶 3~5 大小混装）
    "special": null,       // 特殊关（v1 仅 bigBottle）
    "bigCapacity": 0,      // 大瓶容量（special 时必填、需 ≥ capacity）
    "maxBottles": 12,      // 加瓶上限（道具加瓶时瓶子总数不得超过此值）
    "props": { "shuffle": 1, "addBottle": 1 } // 道具出厂（≥L10 各关显式归零，仅广告补给）
  },

  // —— 30 关逐关记录（缺失参数按 defaults；特殊关/混合关强制清零锁与隐藏，v1 不叠加）——
  // 2026-10-26 按实测难度重排（docs/解题报告-30关.md）：移动过的记录带显式 seed（= 101 + 原关号）
  // 冻结原牌面，避免重排导致全部关卡重新洗牌；注释标注「← 原Ln」。
  "levels": [
    // 新手段 1~9：颜色 2→6、隐藏层第 4 关起 1→3 爬坡，道具免费（同配置对内按牌面难度排序）
    { "level": 1, "colors": 2 },
    { "level": 2, "colors": 3, "seed": 104 }, // ← 原 L3
    { "level": 3, "colors": 3, "seed": 103 }, // ← 原 L2
    { "level": 4, "colors": 4, "hiddenCount": 1, "seed": 106 }, // ← 原 L5
    { "level": 5, "colors": 4, "hiddenCount": 1, "seed": 105 }, // ← 原 L4
    { "level": 6, "colors": 5, "hiddenCount": 2, "seed": 108 }, // ← 原 L7
    { "level": 7, "colors": 5, "hiddenCount": 2, "seed": 107 }, // ← 原 L6
    { "level": 8, "colors": 6, "hiddenCount": 3, "seed": 110 }, // ← 原 L9
    { "level": 9, "colors": 6, "hiddenCount": 3, "seed": 109 }, // ← 原 L8
    // 特殊关① 大瓶收集首秀（8 层大瓶，4 色纯机制教学）
    { "level": 10, "special": "bigBottle", "bigCapacity": 8, "colors": 4, "empties": 2, "props": { "shuffle": 0, "addBottle": 0 } },
    // 中段 11~19：混合首秀（选实测最易的混合牌面）→ 7 色 → 8 色渐入 → 段末冲高
    { "level": 11, "mix": true, "colors": 6, "empties": 1, "seed": 127, "props": { "shuffle": 0, "addBottle": 0 } }, // 混合首秀 ← 原 L26
    { "level": 12, "colors": 7, "hiddenCount": 4, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 13, "colors": 7, "hiddenCount": 4, "seed": 112, "props": { "shuffle": 0, "addBottle": 0 } }, // ← 原 L11
    { "level": 14, "mix": true, "colors": 6, "empties": 2, "seed": 118, "props": { "shuffle": 0, "addBottle": 0 } }, // ← 原 L17
    { "level": 15, "colors": 8, "empties": 1, "hiddenCount": 5, "props": { "shuffle": 0, "addBottle": 0 } }, // 8 色首秀
    { "level": 16, "colors": 8, "empties": 1, "hiddenCount": 5, "seed": 119, "props": { "shuffle": 0, "addBottle": 0 } }, // ← 原 L18
    { "level": 17, "mix": true, "colors": 6, "empties": 2, "seed": 114, "props": { "shuffle": 0, "addBottle": 0 } }, // ← 原 L13
    { "level": 18, "colors": 8, "empties": 2, "hiddenCount": 5, "seed": 115, "props": { "shuffle": 0, "addBottle": 0 } }, // ← 原 L14
    { "level": 19, "colors": 8, "empties": 1, "hiddenCount": 5, "seed": 117, "props": { "shuffle": 0, "addBottle": 0 } }, // ← 原 L16
    // 特殊关② 中场 Boss（单独评估加压：colors 5→6，大瓶 6 层收窄颜色压力）
    { "level": 20, "special": "bigBottle", "bigCapacity": 6, "colors": 6, "empties": 2, "props": { "shuffle": 0, "addBottle": 0 } },
    // 后段 21~29：cap3 缓冲 → 混合/8 色 → cap5 峰值 → 锁段（条件→钥匙→双锁）→ 无空瓶收官
    { "level": 21, "colors": 6, "empties": 1, "capacity": 3, "hiddenCount": 4, "props": { "shuffle": 0, "addBottle": 0 } }, // cap3 首秀
    { "level": 22, "mix": true, "colors": 6, "empties": 1, "seed": 124, "props": { "shuffle": 0, "addBottle": 0 } }, // ← 原 L23
    { "level": 23, "colors": 8, "empties": 1, "hiddenCount": 5, "seed": 120, "props": { "shuffle": 0, "addBottle": 0 } }, // ← 原 L19
    { "level": 24, "colors": 6, "empties": 1, "capacity": 5, "hiddenCount": 4, "seed": 123, "props": { "shuffle": 0, "addBottle": 0 } }, // cap5 首秀 ← 原 L22
    { "level": 25, "colors": 8, "empties": 1, "hiddenCount": 5, "condLockCount": 1, "props": { "shuffle": 0, "addBottle": 0 } }, // 条件锁首秀
    { "level": 26, "colors": 8, "empties": 1, "hiddenCount": 5, "condLockCount": 1, "seed": 125, "props": { "shuffle": 0, "addBottle": 0 } }, // ← 原 L24
    { "level": 27, "colors": 8, "empties": 1, "hiddenCount": 5, "keyLockCount": 1, "props": { "shuffle": 0, "addBottle": 0 } }, // 钥匙锁首秀
    { "level": 28, "colors": 8, "empties": 1, "hiddenCount": 5, "condLockCount": 1, "keyLockCount": 1, "props": { "shuffle": 0, "addBottle": 0 } }, // 双锁合璧
    { "level": 29, "colors": 7, "hiddenCount": 4, "noEmptyStart": true, "props": { "shuffle": 0, "addBottle": 0 } }, // 无空瓶首秀
    // 特殊关③ 终局 Boss（cap5 普通瓶 + 8 层大瓶收官）
    { "level": 30, "special": "bigBottle", "bigCapacity": 8, "colors": 6, "capacity": 5, "empties": 2, "props": { "shuffle": 0, "addBottle": 0 } }
  ]
}
