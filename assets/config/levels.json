{
  // ═══════════════════════════════════════════════════════════
  // 缤纷果汁铺 · 关卡难度曲线配置（JSONC：JSON with Comments）
  // 全部关卡（第 1 ~ levelCount 关）由本配置程序化生成，
  // 调整参数即可改变关卡数量与难度曲线，无需改动代码。
  //
  // 说明：本文件内容为 JSONC（JSON + 注释）。
  // 微信小游戏仅允许读取 .json 等白名单扩展名的代码包文件
  // （.jsonc 扩展名会被文件系统拒绝），故用 .json 扩展名存放，
  // 加载时由 js/core/levels.js 的 parseJsonc 剥离注释后解析。
  // 加载链路：js/main.js 读取本文件 → parseJsonc → 生成关卡列表
  // ═══════════════════════════════════════════════════════════
  "levelCount": 10, // 关卡总数
  "startColors": 2, // 第 1 关颜色数
  "maxColors": 7, // 颜色数上限（颜色数每 2 关 +1，封顶此值）
  "baseEmpties": 2, // 基础空瓶数
  "extraEmptyFromLevel": 7, // 第几关起额外 +1 空瓶（颜色变多时缓和难度）
  "hiddenFromLevel": 4, // 第几关起出现「?」隐藏层
  "hiddenMax": 3, // 隐藏层最大数量（出现后每 2 关 +1，封顶此值）
  "seedBase": 101 // 随机种子基准（seed = 基准 + 关卡号，同 seed 局面可复现）
}