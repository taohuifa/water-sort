{
  // ═══════════════════════════════════════════════════════════
  // 缤纷果汁铺 · 关卡配置 v3（逐关显式，JSONC）
  //
  // 结构：defaults（默认关卡模板）+ levels（每关一条记录，聚合在一起）。
  // 取值优先级：levels[n].<字段>  >  defaults.<字段>  >  内置兜底。
  //
  // 生成管线（v3 分级，可解性保证）：
  //   ① 瓶结构（大小/数量 + 空瓶）→ ② 机制位置（隐藏槽位/锁瓶/钥匙深度）
  //   → ③ 液体打散洗混 → ④ DFS 求解器验证（不用道具必有解），不合格换 attempt 重洗
  //
  // 逐关随机种子 seed：缺省 = seedBase + 关卡号。对某关生成局面满意后，
  // 把该 seed 写进该关记录（"seed": N）即可固化局面——同 seed 永远复现同一副牌；
  // 不满意时改一个新 seed 即可换一副牌，不影响其他关。
  //
  // 说明：本文件内容为 JSONC（JSON + 注释）。微信小游戏仅允许读取 .json 等
  // 白名单扩展名的代码包文件，故用 .json 扩展名存放，加载时由 js/core/levels.js
  // 的 parseJsonc 剥离注释后解析。
  // ═══════════════════════════════════════════════════════════
  "levelCount": 30,
  "seedBase": 101,

  // —— 默认关卡模板（每条关卡记录缺失的字段回退到这里）——
  "defaults": {
    "colors": 4,           // 颜色数
    "empties": 2,          // 空瓶数（中转位）
    "capacity": 4,         // 每瓶层数（均一容量关）
    "hiddenCount": 0,      // 「?」隐藏层数
    "condLockCount": 0,    // 条件锁数
    "condLockNeed": 2,     // 条件锁需完成成品数
    "keyLockCount": 0,     // 钥匙锁数
    "noEmptyStart": false, // 无空瓶开局
    "mix": false,          // 混合容量关（瓶 3~5 大小混装）
    "special": null,       // 特殊关（v1 仅 bigBottle）
    "bigCapacity": 0,      // 大瓶容量（special 时必填、需 ≥ capacity）
    "props": { "shuffle": 1, "addBottle": 1 } // 道具出厂（≥L10 各关显式归零，仅广告补给）
  },

  // —— 30 关逐关记录（缺失参数按 defaults；特殊关/混合关强制清零锁与隐藏，v1 不叠加）——
  "levels": [
    // 新手期 L1~L9：颜色 2→6、隐藏层 L4 起 1→3 爬坡，道具免费
    { "level": 1, "colors": 2 },
    { "level": 2, "colors": 3 },
    { "level": 3, "colors": 3 },
    { "level": 4, "colors": 4, "hiddenCount": 1 },
    { "level": 5, "colors": 4, "hiddenCount": 1 },
    { "level": 6, "colors": 5, "hiddenCount": 2 },
    { "level": 7, "colors": 5, "hiddenCount": 2 },
    { "level": 8, "colors": 6, "hiddenCount": 3 },
    { "level": 9, "colors": 6, "hiddenCount": 3 },
    // L10 特殊关①：大瓶收集首秀（8 层大瓶 ≈ 2 个满普通瓶，纯机制教学）
    { "level": 10, "special": "bigBottle", "bigCapacity": 8, "colors": 4, "empties": 2, "props": { "shuffle": 0, "addBottle": 0 } },
    // L11~L12 中段 7 色压力
    { "level": 11, "colors": 7, "hiddenCount": 4, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 12, "colors": 7, "hiddenCount": 4, "props": { "shuffle": 0, "addBottle": 0 } },
    // L13 混合关首秀：瓶 3~5 大小混装（colors 降 6 缓冲）
    { "level": 13, "mix": true, "colors": 6, "empties": 2, "props": { "shuffle": 0, "addBottle": 0 } },
    // L14~L19 8 色压力段（空瓶 2 → 1 递减）
    { "level": 14, "colors": 8, "empties": 2, "hiddenCount": 5, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 15, "colors": 8, "empties": 1, "hiddenCount": 5, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 16, "colors": 8, "empties": 1, "hiddenCount": 5, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 17, "mix": true, "colors": 6, "empties": 2, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 18, "colors": 8, "empties": 1, "hiddenCount": 5, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 19, "colors": 8, "empties": 1, "hiddenCount": 5, "props": { "shuffle": 0, "addBottle": 0 } },
    // L20 特殊关②：颜色压力 +1，大瓶略小（6 层）
    { "level": 20, "special": "bigBottle", "bigCapacity": 6, "colors": 5, "empties": 2, "props": { "shuffle": 0, "addBottle": 0 } },
    // L21~L23 容量段：cap3 小瓶 / cap5 高瓶 / 混合（空瓶 1）
    { "level": 21, "colors": 6, "empties": 1, "capacity": 3, "hiddenCount": 4, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 22, "colors": 6, "empties": 1, "capacity": 5, "hiddenCount": 4, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 23, "mix": true, "colors": 6, "empties": 1, "props": { "shuffle": 0, "addBottle": 0 } },
    // L24~L28 锁段：条件锁 → 混合终章 → 钥匙锁
    { "level": 24, "colors": 8, "empties": 1, "hiddenCount": 5, "condLockCount": 1, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 25, "colors": 8, "empties": 1, "hiddenCount": 5, "condLockCount": 1, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 26, "mix": true, "colors": 6, "empties": 1, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 27, "colors": 8, "empties": 1, "hiddenCount": 5, "keyLockCount": 1, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 28, "colors": 8, "empties": 1, "hiddenCount": 5, "condLockCount": 1, "keyLockCount": 1, "props": { "shuffle": 0, "addBottle": 0 } },
    // 终局：无空瓶开局首秀 → 特殊关③（cap5 普通瓶 + 8 层大瓶收官）
    { "level": 29, "colors": 7, "hiddenCount": 4, "noEmptyStart": true, "props": { "shuffle": 0, "addBottle": 0 } },
    { "level": 30, "special": "bigBottle", "bigCapacity": 8, "colors": 6, "capacity": 5, "empties": 2, "props": { "shuffle": 0, "addBottle": 0 } }
  ]
}
